RESEND_API_KEY=re_your_key_here
# Where new-lead alert emails go (and optional custom sender once a domain is verified in Resend)
LEAD_ALERT_EMAIL=you@example.com
# LEAD_ALERT_FROM="Number 1 Leads <leads@yourdomain.com>"
NEXT_PUBLIC_SITE_URL=https://number1digitalmarketing.com

# Google Sheets — contact form submissions
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-writer@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Academy LMS — Supabase (Project Settings → API). The anon key is safe to expose;
# access is enforced by the row level security policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NFC shop (/shop) — Stripe (Developers → API keys). Without a secret key the shop page
# still shows, but checkout says "not open yet" (and skips straight to the thank-you page locally).
STRIPE_SECRET_KEY=sk_live_or_test_key_here
# Stripe → Developers → Webhooks → endpoint https://number1digitalmarketing.com/api/shop/webhook
# with events checkout.session.completed and checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
# Set to 1 once Stripe Tax is set up to charge sales tax
# STRIPE_AUTOMATIC_TAX=1

# NFC lead form (/en/nfc-lead) for the owner and sales reps
# Admin email that sees the form's share link in /admin (defaults to the owner's email in lib/adminAuth.ts)
# OWNER_EMAIL=you@example.com
# Key carried in the form link. Optional: derived from GOOGLE_PRIVATE_KEY if unset. Change it to revoke old links.
# NFC_FORM_KEY=some-random-string
