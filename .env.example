RESEND_API_KEY=re_your_key_here
# Where new-lead alert emails go (and optional custom sender once a domain is verified in Resend)
LEAD_ALERT_EMAIL=you@example.com
# LEAD_ALERT_FROM="Number 1 Leads <leads@yourdomain.com>"
NEXT_PUBLIC_SITE_URL=https://number1digitalmarketing.com

# Google Sheets — contact form submissions
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-writer@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Academy LMS — Supabase (Project Settings → API). The anon key is safe to expose;
# access is enforced by the row level security policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
